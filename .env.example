# ─── Django Core ───────────────────────────────────────────────────────────────
# Generate a new key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-random-50-char-string

# Set to False in production
DEBUG=True

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF (include your production domain)
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ─── Database ──────────────────────────────────────────────────────────────────
# Leave blank to use SQLite locally.
# Set to your PostgreSQL connection string in production.
# Format: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

# ─── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_EMAIL=info@yourdomain.com
SMTP_PASSWORD=your-smtp-password
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465

# Admin receives order notification emails
ADMIN_EMAIL=admin@yourdomain.com

# Shown in email From: header
DEFAULT_FROM_EMAIL=info@yourdomain.com
